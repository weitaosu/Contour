# --- desk service ---
PORT=4000
WEB_ORIGIN=http://localhost:3000
DB_PATH=../../data/desk.sqlite
LOG_LEVEL=info

# Gemini (public data needs no key)
GEMINI_API_BASE=https://api.gemini.com
# paper (default) | sandbox | live. A live order is only ever placed with EXECUTION_MODE=live AND ALLOW_LIVE_ORDERS=true.
EXECUTION_MODE=paper
ALLOW_LIVE_ORDERS=false
GEMINI_API_KEY=
GEMINI_API_SECRET=
# Extra categories for the market list, and the allowlist of exclusive named-outcome events (never guessed)
MARKET_CATEGORIES=*
CATEGORICAL_ALLOWLIST=DEMNOM2028,REPNOM2028

# Solana (devnet only)
SOLANA_RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=BrTbVXVsKMNYQiAfRohLCK2tH5wSpEgwvc8TctWrVT7g
USDC_MINT=8Uwf97QUwPHF4ppzQDCqUWCB6AEweJiSc2iRevqbukYZ
DESK_KEYPAIR_PATH=../../keys/desk.json
ORACLE_KEYPAIR_PATH=../../keys/oracle.json
# Mint authority of the test USDC mint, used by the devnet faucet only
MINT_AUTHORITY_KEYPAIR_PATH=../../keys/admin.json
FAUCET_ENABLED=true
SCHEDULER_ENABLED=true

# QuickNode Stream security token (Stream settings tab). The webhook rejects unsigned deliveries.
QUICKNODE_STREAM_TOKEN=

# Run the 5-minute snapshot recorder inside the server (or run `pnpm recorder` separately)
RECORDER_ENABLED=false

# "Ask Grok" chat: an xAI API key from console.x.ai (the desk keeps it; it never reaches the browser)
XAI_API_KEY=
# Optional: the Grok model, and live web/X search for news (on unless false)
XAI_MODEL=grok-4
XAI_LIVE_SEARCH=true
